# =============================================================================
# AMR Simulator - Environment Variables
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# --- PostgreSQL (with PostGIS) -----------------------------------------------
DATABASE_URL=postgresql://amr:amr@localhost:5432/amr
POSTGRES_DB=amr
POSTGRES_USER=amr
POSTGRES_PASSWORD=amr

# Asset-manager database (separate DB)
ASSET_MANAGER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amr_assets

# Map-manager database (separate DB, PostGIS required)
MAP_MANAGER_DATABASE_URL=postgres://amr:amr@localhost:5432/amr_maps

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- MinIO / S3-compatible object storage ------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Per-service buckets
ASSET_MANAGER_MINIO_BUCKET=assets
MAP_MANAGER_MINIO_BUCKET=map-tiles

# --- MQTT broker -------------------------------------------------------------
MQTT_BROKER_URL=mqtt://localhost:1883

# --- JWT authentication ------------------------------------------------------
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRATION_SECS=3600

# --- gRPC service endpoints --------------------------------------------------
GRPC_SIM_ENGINE_URL=http://localhost:50051
GRPC_ASSET_MANAGER_URL=http://localhost:50052
GRPC_MAP_MANAGER_URL=http://localhost:50053

# --- Service ports -----------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000
ASSET_MANAGER_GRPC_PORT=50052
MAP_MANAGER_GRPC_PORT=50053

# --- Logging -----------------------------------------------------------------
RUST_LOG=info,amr_backend=debug,amr_asset_manager=debug
